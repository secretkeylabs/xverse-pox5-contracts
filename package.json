{
  "name": "xverse-pox5-contracts-tests",
  "version": "1.0.0",
  "description": "Clarity smart contracts for Xverse PoX-5 integrations.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "generate": "bun scripts/generate.ts && clarinet deployments generate --simnet",
    "check:generated": "bun scripts/generate.ts --check",
    "check": "clarinet check && bun run check:types",
    "check:types": "tsc --noEmit",
    "check:format": "clarinet format --check",
    "test": "vitest run",
    "test:lanes": "vitest run tests/generation.test.ts tests/six-lane-integration.test.ts tests/six-lane-rollover.simulation.test.ts",
    "simulate:rollover": "vitest run tests/six-lane-rollover.simulation.test.ts",
    "test:report": "vitest run -- --coverage --costs && bun scripts/check-validation-reports.ts",
    "check:reports": "bun scripts/check-validation-reports.ts",
    "validate": "bun run check:generated && bun run check && bun run test && bun run test:report && bun run test:lanes && bun run simulate:rollover && bun run check:format",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"bun run test:report\""
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stacks/clarinet-sdk": "^3.9.0",
    "@stacks/transactions": "^7.2.0",
    "@types/node": "^24.4.0",
    "chokidar-cli": "^3.0.0",
    "vitest": "^4.1.8",
    "vitest-environment-clarinet": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
