    code-hash (match (map-get? trusted-signers code-hash)
      ;; Trusted while epoch `trusted-at - 1` was live; usable once the pool
      ;; has opened a later one.
      trusted-at
      (> (var-get epoch-count) trusted-at)
      false
    )
    error false
  )
)

